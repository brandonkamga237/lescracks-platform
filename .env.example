# =============================================================================
# LesCracks Platform - Production environment variables
# =============================================================================
# Copy this file to .env on the server: /root/lescracks/.env
# NEVER commit the .env file
#
# Every variable here is required: application-prod.yml gives none of them a
# default, so the backend refuses to start rather than run on a dev value.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=lescracks-postgres
DB_PORT=5432
DB_NAME=lescracks
DB_USERNAME=lescracks
DB_PASSWORD=CHANGE_ME_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRATION=86400000

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Identity lives here: passwords, Google, GitHub, reset flows and login throttling.
# The issuer must be the public https URL, not the container name — it is the value
# written into every token and the one the API checks.
KEYCLOAK_HOSTNAME=auth.lescracks.com
KEYCLOAK_ISSUER_URI=https://auth.lescracks.com/realms/lescracks
# Internal URL the API uses to fetch Keycloak public keys inside the Docker network.
KEYCLOAK_JWKS_URI=http://lescracks-keycloak:8080/realms/lescracks/protocol/openid-connect/certs
KEYCLOAK_ADMIN=CHANGE_ME_admin_user
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── SMTP / Mail ───────────────────────────────────────────────────────────────
# The API sends verification, reset and newsletter emails from this account.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD="CHANGE_ME"
MAIL_FROM=LesCracks <contact@lescracks.com>
MAIL_AUTH=true
MAIL_STARTTLS=true
MANAGEMENT_HEALTH_MAIL_ENABLED=false
# Local Mailpit only. Its web inbox is available at http://localhost:8025.
MAIL_UI_PORT=8025

# Google and GitHub sign-in are configured in the Keycloak console, per provider.
# The realm ships them disabled; fill in the credentials there and enable them.

# ── URLs ──────────────────────────────────────────────────────────────────────
# SITE_URL is the canonical origin written into the SEO snapshots and the sitemap.
SITE_URL=https://lescracks.com
CORS_ORIGINS=https://lescracks.com,https://www.lescracks.com

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password
MINIO_BUCKET=lescracks
MINIO_ENDPOINT=http://lescracks-minio:9000
MINIO_PUBLIC_URL=https://minio.lescracks.com

# ── Server / Hibernate ────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
# Keep `validate` normally. Use `update` only for a one-off repair if Flyway/Hibernate drift.
SPRING_DDL_AUTO=validate
UPLOADS_DIR=/app/uploads

# Optional, defaults to 25MB. Raise it only alongside the proxy's own body limit.
# MAX_UPLOAD_SIZE=25MB
